fn double_elements(arr: int[], size: int): void {
    for (let i: int = 0; i < size; i = i + 1) {
        arr[i] = arr[i] * 2;
    }
}

fn print_array(arr: int[], size: int): void {
    for (let i: int = 0; i < size; i = i + 1) {
        print(arr[i]);
    }
}

fn main(): int {
    let vals: int[] = [1, 2, 3, 4, 5];
    double_elements(vals, 5);
    print_array(vals, 5);
    return 0;
}
