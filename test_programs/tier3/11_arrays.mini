fn sum_array(arr: int[], size: int): int {
    let total: int = 0;
    for (let i: int = 0; i < size; i = i + 1) {
        total = total + arr[i];
    }
    return total;
}

fn main(): int {
    let nums: int[] = [10, 20, 30, 40, 50];
    let sum: int = sum_array(nums, 5);
    print(sum);
    return 0;
}
