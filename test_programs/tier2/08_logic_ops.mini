fn check_range(val: int, min: int, max: int): int {
    if (val >= min && val <= max) {
        return 1;
    }
    return 0;
}

fn main(): int {
    let a: int = check_range(5, 1, 10);
    let b: int = check_range(15, 1, 10);
    
    if (a == 1 || b == 1) {
        print(1);
    } else {
        print(0);
    }
    
    let not_a: int = 0;
    if (!a) { // Assuming parser treats int as boolean in logic
        not_a = 1;
    }
    print(not_a);
    
    return 0;
}
