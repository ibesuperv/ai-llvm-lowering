fn max(a: int, b: int): int {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fn min(a: int, b: int): int {
    if (a < b) {
        return a;
    }
    return b;
}

fn main(): int {
    let x: int = max(10, 20);
    let y: int = min(x, 5);
    print(x);
    print(y);
    return 0;
}
