# Copy this file to .env and fill in your own keys
# cp .env.example .env

# ── Google Gemini API Key ──────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, resets daily
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq API Key (Llama 3.3 70B) ──────────────────────────────────────────
# Get free key at: https://console.groq.com/
# Free tier: 30 requests/minute, no daily cap
GROQ_API_KEY=your_groq_api_key_here

# ── LLVM Tool Paths ────────────────────────────────────────────────────────
# Default paths work if installed via: sudo apt install llvm-18
# Change only if your LLVM is installed in a non-standard location
LLVM_AS_PATH=/usr/bin/llvm-as
LLI_PATH=/usr/bin/lli
